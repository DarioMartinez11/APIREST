          "operationId": "deleteCocheFromConcesionario",
          "parameters": [
            {
              "in": "path",
              "name": "id",
              "required": true,
              "type": "string"
            },
            {
              "in": "path",
              "name": "cocheId",
              "required": true,
              "type": "integer"
            }
          ],

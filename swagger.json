              "required": true,
              "type": "string"
            },
            {
              "in": "path",
              "name": "cocheId",
              "required": true,
              "type": "integer"
            },
            {
              "in": "body",
              "name": "coche",
              "schema": {
                "$ref": "#/definitions/Coche"
              }
            }

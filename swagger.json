{
    "swagger": "2.0",
    "basePath": "/",
    "info": {
      "title": "Concesionarios API",
      "version": "1.0.0"
    },
    "definitions": {
      "Coche": {
        "type": "object",
        "properties": {
          "modelo": {
            "type": "string"
          },
          "cv": {
            "type": "integer"
          },
          "precio": {
            "type": "number"
          }
        },
        "required": ["modelo", "cv", "precio"]
      },
      "Concesionario": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          },
          "coches": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Coche"
            }
          }
        },
        "required": ["nombre", "direccion", "coches"]
      }
    },
    "paths": {
